# Copy to .env and adjust before `docker compose up`.

# App
APP_PORT=80
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
ADMIN_NOTIFY_EMAIL=frenixraj@gmail.com
DEFAULT_FROM_EMAIL=AssetFlow <noreply@assetflow.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
SEED_DEMO_USERS=true

# Postgres
DB_NAME=assetflow
DB_USER=assetflow
DB_PASSWORD=assetflow
DB_HOST=db
DB_PORT=5432

# Frontend build: leave empty so the browser calls same-origin /api (nginx proxies)
VITE_API_BASE_URL=
